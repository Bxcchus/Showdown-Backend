:8080 {
    root * /srv

    handle /.openai/* {
        respond 404
    }

    handle {
        try_files {path} /index.html
        file_server
    }

    header {
        -Server
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "DENY"
        Content-Security-Policy "default-src 'self'; connect-src 'self' ws://localhost:8088 ws://127.0.0.1:8088 http://127.0.0.1:43991; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        Cross-Origin-Opener-Policy "same-origin"
    }
}

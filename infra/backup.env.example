# Store the real file as /etc/gyms-lol/backup.env with mode 600 and root ownership.
# Keep the age private identity off the VPS.
AGE_RECIPIENT=age1REPLACE_WITH_PUBLIC_RECIPIENT
S3_ENDPOINT_URL=https://s3.REGION.cloud.ovh.net
S3_BUCKET=REPLACE_WITH_BUCKET
S3_PREFIX=showdown-production
AWS_DEFAULT_REGION=REPLACE_WITH_REGION
AWS_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY
# Optional for temporary credentials:
AWS_SESSION_TOKEN=
BACKUP_RETENTION_DAYS=30

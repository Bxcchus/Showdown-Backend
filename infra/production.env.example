# Copy to a secret manager or an ignored environment file. Never commit real values.
# The API hostname has no scheme; the web origin is the exact HTTPS origin, without a trailing slash.
SHOWDOWN_API_DOMAIN=REPLACE_WITH_API_DOMAIN
SHOWDOWN_WEB_ORIGIN=REPLACE_WITH_WEB_ORIGIN
OIDC_ISSUER_URI=REPLACE_WITH_OIDC_ISSUER
OIDC_CLIENT_ID=REPLACE_WITH_OIDC_CLIENT_ID
OIDC_CLIENT_SECRET=REPLACE_WITH_OIDC_CLIENT_SECRET
ALERTMANAGER_WEBHOOK_URL_FILE=/run/secrets/showdown-alertmanager-webhook-url
POSTGRES_PASSWORD=GENERATE_IN_SECRET_MANAGER
MATCH_POSTGRES_PASSWORD=GENERATE_IN_SECRET_MANAGER
PLAYER_POSTGRES_PASSWORD=GENERATE_IN_SECRET_MANAGER
IDENTITY_POSTGRES_PASSWORD=GENERATE_IN_SECRET_MANAGER
LOBBY_CREDENTIAL_KEY=GENERATE_IN_SECRET_MANAGER
REDIS_PASSWORD=GENERATE_IN_SECRET_MANAGER
RABBITMQ_ADMIN_PASSWORD=GENERATE_IN_SECRET_MANAGER
MATCHMAKING_RABBITMQ_PASSWORD=GENERATE_IN_SECRET_MANAGER
MATCH_RABBITMQ_PASSWORD=GENERATE_IN_SECRET_MANAGER
LOCAL_IDENTITY_USERNAME=disabled-local-user
LOCAL_IDENTITY_PASSWORD=GENERATE_IN_SECRET_MANAGER
LOCAL_IDENTITY_SECONDARY_USERNAME=
LOCAL_IDENTITY_SECONDARY_PASSWORD=GENERATE_IN_SECRET_MANAGER
MATCHMAKING_CLIENT_SECRET=GENERATE_IN_SECRET_MANAGER
PLAYER_CLIENT_SECRET=GENERATE_IN_SECRET_MANAGER
MATCH_CLIENT_SECRET=GENERATE_IN_SECRET_MANAGER
RESULT_INGESTOR_CLIENT_SECRET=GENERATE_IN_SECRET_MANAGER
WATCHER_CLIENT_SECRET=GENERATE_IN_SECRET_MANAGER
WATCHER_INSTALLATION_CREDENTIALS= # gitleaks:allow -- intentionally empty template value
JWT_AUDIENCE=pinkward-api
JWT_ROTATION_AGE=30d
JWT_KEY_OVERLAP=7d
RATE_LIMIT_PLAYERS_REPLENISH=10
RATE_LIMIT_PLAYERS_BURST=20
RATE_LIMIT_PARTIES_REPLENISH=10
RATE_LIMIT_PARTIES_BURST=20
RATE_LIMIT_MATCHMAKING_REPLENISH=5
RATE_LIMIT_MATCHMAKING_BURST=10
RATE_LIMIT_MATCHES_REPLENISH=10
RATE_LIMIT_MATCHES_BURST=20
RATE_LIMIT_WATCHERS_REPLENISH=20
RATE_LIMIT_WATCHERS_BURST=40

{$SHOWDOWN_API_DOMAIN} {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; connect-src 'self' wss://{$SHOWDOWN_API_DOMAIN}; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
	}

	handle /.openai/* {
		respond 404
	}

	@identity path /.well-known/openid-configuration /.well-known/oauth-authorization-server /oauth2/* /connect/* /login* /logout* /error* /userinfo /default-ui.css /identity.css /identity.js /fonts/*
	handle @identity {
		reverse_proxy identity-service:9000
	}

	@gateway path /api/*
	handle @gateway {
		reverse_proxy api-gateway:8080
	}

	@health path /actuator/health/readiness
	handle @health {
		reverse_proxy api-gateway:9101
	}

	handle {
		respond 404
	}

	log {
		format filter {
			request>headers>Authorization delete
			request>headers>Cookie delete
			request>headers>Sec-Websocket-Protocol delete
			request>headers>X-Watcher-Token delete
			request>headers>X-Showdown-Watcher-Token delete
			request>uri query {
				replace code REDACTED
				replace state REDACTED
				replace access_token REDACTED
				replace refresh_token REDACTED
				replace id_token REDACTED
				replace token REDACTED
				replace client_secret REDACTED
				replace password REDACTED
			}
			wrap json
		}
	}
}

{$SHOWDOWN_WEB_ORIGIN} {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://ddragon.leagueoflegends.com; font-src 'self'; connect-src 'self' https://{$SHOWDOWN_API_DOMAIN} wss://{$SHOWDOWN_API_DOMAIN} http://127.0.0.1:43991; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; media-src 'none'; object-src 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
	}

	reverse_proxy web-app:3000

	log {
		format filter {
			request>headers>Authorization delete
			request>headers>Cookie delete
			request>headers>Sec-Websocket-Protocol delete
			request>headers>X-Watcher-Token delete
			request>headers>X-Showdown-Watcher-Token delete
			request>uri query {
				replace code REDACTED
				replace state REDACTED
				replace access_token REDACTED
				replace refresh_token REDACTED
				replace id_token REDACTED
				replace token REDACTED
				replace client_secret REDACTED
				replace password REDACTED
			}
			wrap json
		}
	}
}
